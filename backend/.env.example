# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file to Git.

# Get a free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model name. If this one is retired, check Google AI Studio for a current model.
GEMINI_MODEL=gemini-2.5-flash

# Embedding model (runs locally, no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Chunking and retrieval settings (optional, these are the defaults)
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=4
MIN_SIMILARITY=0.20

# Upload limit in megabytes
MAX_UPLOAD_MB=20

# Frontend URLs allowed to call this API (comma separated)
ALLOWED_ORIGINS=http://localhost:5173
